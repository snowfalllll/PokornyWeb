# Zákaz přímého přístupu k citlivým konfiguračním souborům a zálohám v data/
Options -Indexes

<FilesMatch "^(admin-config\.json|login-attempts\.json|site-data\.json|draft-data\.json)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^backups/ - [F,L]
</IfModule>
